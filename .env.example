# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/ticketing
JWT_SECRET=change-me-to-a-long-random-secret

# Ukuran pool koneksi Postgres (default 24). Throughput DB-bound ≈ pool / latensi.
# total = DB_POOL_MAX_SIZE × jumlah instance app, harus < Postgres max_connections.
# DB_POOL_MAX_SIZE=24

# S3-compatible storage (RustFS / MinIO / S3)
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin

# ─── Optional (have sensible defaults) ────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
# RUSTFS_ENDPOINT = alamat internal app→RustFS (server-to-server), BUKAN untuk browser.
# App jalan DI DALAM container: "127.0.0.1" = container itu sendiri, jadi TAK bisa
# menjangkau RustFS di host. Pakai gateway bridge Docker (172.17.0.1) karena RustFS
# publish 0.0.0.0:9000 ke host. (Alternatif lebih rapi: taruh app & RustFS di satu
# docker network, lalu pakai http://rustfs:9000.)
RUSTFS_ENDPOINT=http://172.17.0.1:9000
# RUSTFS_PUBLIC_URL = alamat yang dilihat BROWSER (masuk DB & di-render). Bucket
# di URL ini harus di-set public: `mc anonymous set download <alias>/ticketing`.
RUSTFS_PUBLIC_URL=https://image.ulalaapi.store

# Internal JWT (SSR ↔ API bridge). Dev default is used if not set.
INTERNAL_JWT_SECRET=change-me-32-chars-minimum

# Auth
JWT_EXPIRY_HOURS=24
BCRYPT_COST=10

# WhatsApp (optional)
WAHA_BASE_URL=http://localhost:3001
WAHA_SESSION=default
WAHA_API_KEY=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=0

# Live streaming SFU (WebRTC)
# Bind address for the in-process SFU UDP socket (default listens on all interfaces).
SFU_BIND_ADDR=0.0.0.0:4000
# Concrete IP advertised to clients as the ICE host candidate — this is the ONLY
# address a viewer's browser uses to reach the SFU.
#   - Empty   → auto-detect LAN IP. Works ONLY for localhost + same-WiFi devices.
#   - Prod    → MUST be the server's PUBLIC IP. Viewers on cellular / other
#               networks "can't join" (ICE never connects) unless this is set.
# Must NOT be 0.0.0.0. Also open the SFU UDP port (4000) inbound in your firewall
# / security group — WebRTC media is UDP, separate from the HTTP port (3000).
# ── ⚠️ SETEL INI SAAT MENGEMBANGKAN DI MESIN BER-VPN ────────────────────────
# Deteksi otomatis mencari antarmuka lewat tabel rute. VPN full-tunnel
# (WireGuard/Tailscale dengan AllowedIPs 0.0.0.0/0) menangkap SELURUH rute,
# termasuk rentang privat — jadi yang terdeteksi adalah alamat terowongan
# (mis. 10.13.13.2), bukan antarmuka yang dipakai melayani browser.
#
# Gejalanya menyesatkan karena ICE tetap BERHASIL: socket terikat 0.0.0.0, jadi
# paket ke alamat mana pun tetap sampai, dan STUN hanya butuh itu. Yang gagal
# DTLS — balasan SFU keluar dengan alamat sumber pilihan kernel, tak cocok
# dengan pasangan kandidat yang disepakati, lalu dibuang browser. Log menunjukkan
# `ICE state Connected` disusul diam total dan `v_seen=0 a_seen=0`, lalu putus
# ~20 detik kemudian saat consent freshness habis. Layar hitam tanpa galat.
#
# Nilai yang benar = alamat yang dipakai KLIEN untuk menjangkau server ini:
#   menguji di mesin yang sama → SFU_PUBLIC_IP=127.0.0.1
#   perangkat lain se-WiFi     → IP LAN mesin ini (mis. 192.168.1.10)
#   produksi                   → IP PUBLIK server, + buka UDP port SFU
SFU_PUBLIC_IP=
# (Optional) TURN relay for viewers behind restrictive/symmetric NAT, once the
# SFU itself is publicly reachable. Requires a coturn server + delivering creds
# to the browser iceServers. Not wired yet — ask if you want this added.
# TURN_URL=turn:turn.example.com:3478
# TURN_USER=
# TURN_PASS=

# Meet (WebRTC P2P mesh — konferensi merchant ↔ tamu undangan)
# Tidak perlu config server: meet hanya signaling + waiting room (lihat src/meet/).
# Media mengalir langsung antar-browser (mesh, ideal ≤ ~6 peserta). Untuk peserta
# di belakang NAT simetris lintas-jaringan, butuh TURN yang sama seperti di atas;
# saat ini hanya STUN Google yang dipakai (cukup untuk LAN/demo).

# ── Migrasi ───────────────────────────────────────────────────────────────────
# Migrasi dijalankan otomatis saat start, dijaga pg_advisory_lock (aman untuk
# beberapa replika). Gagal migrasi = gagal start, disengaja.
#
# Set false bila deployment menjalankan migrasi lewat langkah terpisah.
AUTO_MIGRATE=true

# Cookie sesi memakai `; Secure` sebagai BAWAAN. Peramban memperlakukan
# localhost/127.0.0.1 sebagai asal tepercaya, jadi ini tetap bekerja saat
# `make dev`. Set 0 HANYA bila menguji lewat IP LAN dari perangkat lain.
COOKIE_SECURE=1

# ═══════════════════════════════════════════════════════════════════════════
# PEMBAYARAN
# ═══════════════════════════════════════════════════════════════════════════
#
# Order menjadi LUNAS hanya lewat webhook gateway yang tanda tangannya
# terverifikasi (`src/payment/webhook.rs`). Tak ada jalur lain.
#
# Daftarkan URL ini di dasbor tiap gateway:
#   https://<domain>/api/payment/webhook/midtrans
#   https://<domain>/api/payment/webhook/stripe
#   https://<domain>/api/payment/webhook/flip
#   https://<domain>/api/payment/webhook/faspay

# Satu saklar untuk SEMUA gateway. Campuran sandbox+produksi dalam satu proses
# adalah keadaan yang tak pernah dimaksud siapa pun dan sulit dikenali dari log.
PAYMENT_PRODUCTION=0

# ── JALUR TIRUAN — JANGAN PERNAH "1" DI PRODUKSI ──────────────────────────
# Menyalakan `confirm_order_payment` & `confirm_subscription_payment`, yang
# menerbitkan tiket / mengaktifkan premium TANPA bukti bayar apa pun. Berguna
# saat mengembangkan alur checkout; bencana bila tertinggal menyala.
PAYMENT_MOCK=0

# ── Midtrans ──────────────────────────────────────────────────────────────
# ServerKey (SB-Mid-server-… / Mid-server-…), BUKAN ClientKey.
MIDTRANS_SERVER_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────
# STRIPE_WEBHOOK_SECRET adalah `whsec_…` dari halaman endpoint webhook,
# BUKAN kunci API `sk_…`. Keduanya beredar berdampingan dan sering tertukar.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://ulala.space/orders
STRIPE_CANCEL_URL=https://ulala.space/cart

# ── Flip for Business ─────────────────────────────────────────────────────
# PERHATIAN: callback Flip TIDAK ditandatangani. `FLIP_VALIDATION_TOKEN` adalah
# token TETAP dari dasbor — ia membuktikan pengirimnya tahu rahasia kita, tapi
# tidak membuktikan muatannya tak disunting, dan ia tak pernah basi. Yang
# menahan sisanya adalah pencocokan nominal di `webhook.rs`.
FLIP_SECRET_KEY=
FLIP_VALIDATION_TOKEN=
FLIP_REDIRECT_URL=https://ulala.space/orders

# ── Faspay ────────────────────────────────────────────────────────────────
# FASPAY_PASSWORD: periksa di dasbor apakah akunmu memakai sandi ASLI atau
# MD5-nya. Salah satu dari dua kemungkinan itu membuat SETIAP notifikasi
# ditolak, dan bentuk kegagalannya tidak menunjukkan sebabnya.
FASPAY_USER_ID=
FASPAY_PASSWORD=
FASPAY_MERCHANT_ID=
FASPAY_RETURN_URL=https://ulala.space/orders
