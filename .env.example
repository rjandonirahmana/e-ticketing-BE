# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/ticketing
JWT_SECRET=change-me-to-a-long-random-secret

# Ukuran pool koneksi Postgres (default 24). Throughput DB-bound ≈ pool / latensi.
# total = DB_POOL_MAX_SIZE × jumlah instance app, harus < Postgres max_connections.
# DB_POOL_MAX_SIZE=24

# S3-compatible storage (RustFS / MinIO / S3)
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin

# ─── Optional (have sensible defaults) ────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
# RUSTFS_ENDPOINT = alamat internal app→RustFS (server-to-server), BUKAN untuk browser.
# App jalan DI DALAM container: "127.0.0.1" = container itu sendiri, jadi TAK bisa
# menjangkau RustFS di host. Pakai gateway bridge Docker (172.17.0.1) karena RustFS
# publish 0.0.0.0:9000 ke host. (Alternatif lebih rapi: taruh app & RustFS di satu
# docker network, lalu pakai http://rustfs:9000.)
RUSTFS_ENDPOINT=http://172.17.0.1:9000
# RUSTFS_PUBLIC_URL = alamat yang dilihat BROWSER (masuk DB & di-render). Bucket
# di URL ini harus di-set public: `mc anonymous set download <alias>/ticketing`.
RUSTFS_PUBLIC_URL=https://image.ulalaapi.store

# Internal JWT (SSR ↔ API bridge). Dev default is used if not set.
INTERNAL_JWT_SECRET=change-me-32-chars-minimum

# Auth
JWT_EXPIRY_HOURS=24
BCRYPT_COST=10

# WhatsApp (optional)
WAHA_BASE_URL=http://localhost:3001
WAHA_SESSION=default
WAHA_API_KEY=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=0

# Live streaming SFU (WebRTC)
# Bind address for the in-process SFU UDP socket (default listens on all interfaces).
SFU_BIND_ADDR=0.0.0.0:4000
# Concrete IP advertised to clients as the ICE host candidate — this is the ONLY
# address a viewer's browser uses to reach the SFU.
#   - Empty   → auto-detect LAN IP. Works ONLY for localhost + same-WiFi devices.
#   - Prod    → MUST be the server's PUBLIC IP. Viewers on cellular / other
#               networks "can't join" (ICE never connects) unless this is set.
# Must NOT be 0.0.0.0. Also open the SFU UDP port (4000) inbound in your firewall
# / security group — WebRTC media is UDP, separate from the HTTP port (3000).
SFU_PUBLIC_IP=
# (Optional) TURN relay for viewers behind restrictive/symmetric NAT, once the
# SFU itself is publicly reachable. Requires a coturn server + delivering creds
# to the browser iceServers. Not wired yet — ask if you want this added.
# TURN_URL=turn:turn.example.com:3478
# TURN_USER=
# TURN_PASS=

# Meet (WebRTC P2P mesh — konferensi merchant ↔ tamu undangan)
# Tidak perlu config server: meet hanya signaling + waiting room (lihat src/meet/).
# Media mengalir langsung antar-browser (mesh, ideal ≤ ~6 peserta). Untuk peserta
# di belakang NAT simetris lintas-jaringan, butuh TURN yang sama seperti di atas;
# saat ini hanya STUN Google yang dipakai (cukup untuk LAN/demo).
